@page "/parts/quick"
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Schnellerfassung · Pinventory</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Schnellerfassung</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Bauteile am Stück einlagern – komplett per Tastatur.
</MudText>

@if (!loaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ---- 1. Kontext: gilt für alle folgenden Einträge ---- *@
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.PinDrop" Size="Size.Small" Class="mr-1" Style="vertical-align: middle" />
            Wohin? <span class="mud-text-secondary">– gilt für alle folgenden Einträge</span>
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudAutocomplete T="int?" Value="categoryId" ValueChanged="OnCategoryChanged" @ref="categoryField" Label="Kategorie"
                                 Placeholder="tippen zum Suchen, z.B. wider"
                                 SearchFunc="SearchCategories" ToStringFunc="CategoryPath" SelectValueOnTab="true" MaxItems="null"
                                 Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="int?" @bind-Value="locationId" Label="Lagerort" Placeholder="tippen zum Suchen, z.B. kasten 2"
                                 SearchFunc="SearchLocations" ToStringFunc="LocationPath" SelectValueOnTab="true" MaxItems="null"
                                 Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HelperText="@(locationTree.Count == 0 ? "Noch keine Lagerorte angelegt" : null)" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* ---- 2. Eingabezeile ---- *@
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Keyboard" Size="Size.Small" Class="mr-1" Style="vertical-align: middle" />
            Bauteil
        </MudText>

        <form @onsubmit="SaveAsync" @onkeydown="OnFormKeyDown" autocomplete="off">
            @* Neuer Key nach jedem Speichern → Felder werden frisch aufgebaut und sicher geleert. *@
            <MudGrid Spacing="2" @key="rowVersion">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="name" @ref="nameField" Label="@Label("Name *", K.Name)" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" list="dl-names" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField @bind-Value="value" @ref="valueField" Label="@Label("Wert", K.Value)" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" list="dl-values" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <PackagePicker @ref="packageField" Packages="packages" @bind-Value="packageId" Label="@Label("Bauform", K.Package)"
                                   Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="int" @bind-Value="quantity" @ref="quantityField" Label="@Label("Menge", K.Quantity)" Min="0"
                                     Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudNumericField T="int" @bind-Value="minQuantity" @ref="minQuantityField" Label="@Label("Mindestbestand", K.MinQuantity)" Min="0"
                                     Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                @if (applicable.Count > 0)
                {
                    <AttributeFields @ref="attributeFields" Definitions="applicable" Values="attributeInputs"
                                     LabelFunc="d => Label(d.Name, AttrKey(d.Id))" Margin="Margin.Dense" Xs="6" Sm="4" Md="2" />
                }

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="description" @ref="descriptionField" Label="@Label("Kurzbeschreibung", K.Description)" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="manufacturer" @ref="manufacturerField" Label="@Label("Hersteller", K.Manufacturer)" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" list="dl-manufacturers" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="partNumber" @ref="partNumberField" Label="@Label("Teilenummer", K.PartNumber)" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" />
                </MudItem>

                <MudItem xs="12" Class="d-flex flex-wrap align-center gap-3">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.MoveToInbox" Disabled="saving">
                        Einlagern
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        <kbd>Tab</kbd> nächstes Feld · <kbd>Enter</kbd> einlagern · <kbd>Esc</kbd> Zeile leeren ·
                        <kbd>↑</kbd><kbd>↓</kbd> Menge ändern / Bauform wählen
                    </MudText>
                </MudItem>

                <MudItem xs="12" Class="d-flex flex-wrap align-center gap-1">
                    <MudText Typo="Typo.caption" Class="mr-1">
                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Style="vertical-align: middle" />
                        Nach dem Einlagern behalten:
                    </MudText>
                    @foreach (var (key, text) in PinOptions)
                    {
                        var k = key;
                        var isPinned = pinned.Contains(k);
                        <MudChip T="string" Size="Size.Small" tabindex="-1"
                                 Color="@(isPinned ? Color.Primary : Color.Default)" Variant="@(isPinned ? Variant.Filled : Variant.Outlined)"
                                 Icon="@(isPinned ? Icons.Material.Filled.PushPin : null)" OnClick="() => TogglePin(k)">
                            @text
                        </MudChip>
                    }
                </MudItem>
            </MudGrid>
        </form>
    </MudPaper>

    @* ---- 3. Protokoll dieser Sitzung ---- *@
    @if (log.Count > 0)
    {
        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.h6">In dieser Sitzung</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@log.Count Einträge · @log.Sum(e => e.Amount) Stück</MudChip>
        </div>
        <MudSimpleTable Dense="true" Hover="true" Outlined="true" Elevation="0">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Wert</th>
                    <th>Bauform</th>
                    <th>Eigenschaften</th>
                    <th style="text-align: right">Menge</th>
                    <th>Lagerort</th>
                    <th style="width: 1%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in log)
                {
                    <tr @key="e">
                        <td>
                            @if (e.Created)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">neu</MudChip>
                            }
                            else
                            {
                                <MudTooltip Text="Gab es schon – Menge wurde erhöht">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">+ Bestand</MudChip>
                                </MudTooltip>
                            }
                        </td>
                        <td><MudLink Href="@($"parts/{e.PartId}")">@e.Name</MudLink></td>
                        <td>@e.Value</td>
                        <td>@e.Package</td>
                        <td><MudText Typo="Typo.caption" Class="mud-text-secondary">@e.Attributes</MudText></td>
                        <td style="text-align: right; white-space: nowrap">
                            @if (e.Created)
                            {
                                @e.Amount
                            }
                            else
                            {
                                <span>+@e.Amount</span> <span class="mud-text-secondary">(jetzt @e.NewTotal)</span>
                            }
                        </td>
                        <td>@(e.LocationId is int l ? LocationPath(l) : "")</td>
                        <td>
                            <MudTooltip Text="Rückgängig">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" tabindex="-1" OnClick="() => UndoAsync(e)" />
                            </MudTooltip>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    <datalist id="dl-names">@foreach (var v in knownNames) { <option value="@v"></option> }</datalist>
    <datalist id="dl-values">@foreach (var v in knownValues) { <option value="@v"></option> }</datalist>
    <datalist id="dl-manufacturers">@foreach (var v in knownManufacturers) { <option value="@v"></option> }</datalist>
}

@code {
    [SupplyParameterFromQuery(Name = "category")] public int? PresetCategory { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? PresetLocation { get; set; }

    /// <summary>Schlüssel der festen Felder (für Pins und Fokus-Reihenfolge).</summary>
    private static class K
    {
        public const string Name = "name", Value = "value", Package = "package", Quantity = "qty", MinQuantity = "min",
            Description = "desc", Manufacturer = "manu", PartNumber = "mpn";
    }

    private static string AttrKey(int definitionId) => $"a:{definitionId}";

    private record LogEntry(int PartId, bool Created, string Name, string? Value, string? Package, string Attributes,
        int Amount, int NewTotal, int? LocationId);

    private bool loaded;
    private bool saving;
    private bool focusPending;
    private bool focusRowPending;
    private int rowVersion;

    private List<Category> categories = [];
    private List<TreeEntry<Category>> categoryTree = [];
    private List<TreeEntry<StorageLocation>> locationTree = [];
    private Dictionary<int, string> categoryPaths = [];
    private Dictionary<int, string> locationPaths = [];
    private List<Package> packages = [];
    private List<AttributeDefinition> definitions = [];
    private List<AttributeDefinition> applicable = [];

    private List<string> knownNames = [];
    private List<string> knownValues = [];
    private List<string> knownManufacturers = [];

    private readonly List<LogEntry> log = [];

    // Kontext
    private int? categoryId;
    private int? locationId;

    // Eingabezeile
    private string? name;
    private string? value;
    private int? packageId;
    private int quantity = 1;
    private int minQuantity;
    private string? description;
    private string? manufacturer;
    private string? partNumber;
    private Dictionary<int, string?> attributeInputs = [];

    // Standardmäßig behalten: nichts. Für Serien (z.B. Widerstände) Name, Bauform, Menge anpinnen.
    private readonly HashSet<string> pinned = [];

    private MudAutocomplete<int?> categoryField = default!;
    private MudTextField<string?> nameField = default!;
    private MudTextField<string?> valueField = default!;
    private PackagePicker packageField = default!;
    private MudNumericField<int> quantityField = default!;
    private MudNumericField<int> minQuantityField = default!;
    private AttributeFields? attributeFields;
    private MudTextField<string?> descriptionField = default!;
    private MudTextField<string?> manufacturerField = default!;
    private MudTextField<string?> partNumberField = default!;

    /// <summary>Alle Felder in Tab-Reihenfolge mit Anzeigenamen (für Pins und Fokus).</summary>
    private IEnumerable<(string Key, string Text)> PinOptions
    {
        get
        {
            yield return (K.Name, "Name");
            yield return (K.Value, "Wert");
            yield return (K.Package, "Bauform");
            yield return (K.Quantity, "Menge");
            yield return (K.MinQuantity, "Mindestbestand");
            foreach (var d in applicable) yield return (AttrKey(d.Id), d.Name);
            yield return (K.Description, "Beschreibung");
            yield return (K.Manufacturer, "Hersteller");
            yield return (K.PartNumber, "Teilenummer");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.Categories.AsNoTracking().ToListAsync();
        categoryTree = Tree.Flatten(categories);
        locationTree = Tree.Flatten(await db.StorageLocations.AsNoTracking().ToListAsync());
        categoryPaths = categoryTree.ToDictionary(e => e.Node.Id, e => e.Path);
        locationPaths = locationTree.ToDictionary(e => e.Node.Id, e => e.Path);
        packages = await db.Packages.AsNoTracking().ToListAsync();
        definitions = await db.AttributeDefinitions.AsNoTracking().ToListAsync();

        var all = await db.Parts.AsNoTracking().Select(p => new { p.Name, p.Value, p.Manufacturer }).ToListAsync();
        knownNames = Distinct(all.Select(p => p.Name));
        knownValues = Distinct(all.Select(p => p.Value));
        knownManufacturers = Distinct(all.Select(p => p.Manufacturer));

        categoryId = PresetCategory is int c && categoryPaths.ContainsKey(c) ? c : null;
        locationId = PresetLocation is int l && locationPaths.ContainsKey(l) ? l : null;
        applicable = Attributes.For(categoryId, categories, definitions);

        loaded = true;
        focusPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loaded) return;
        if (focusPending)
        {
            focusPending = false;
            // Mit Vorbelegung direkt in die Eingabezeile, sonst erst Kategorie wählen.
            if (categoryId is null && locationId is null) await categoryField.FocusAsync();
            else await nameField.FocusAsync();
        }
        else if (focusRowPending)
        {
            focusRowPending = false;
            await FocusFirstFreeFieldAsync();
        }
    }

    // ---------- Anzeige ----------

    private string Label(string text, string key) => pinned.Contains(key) ? $"{text} 📌" : text;

    private string CategoryPath(int? id) => id is int i ? categoryPaths.GetValueOrDefault(i) ?? "" : "";
    private string LocationPath(int? id) => id is int i ? locationPaths.GetValueOrDefault(i) ?? "" : "";

    private Task<IEnumerable<int?>> SearchCategories(string? text, CancellationToken _) => Task.FromResult(Search(categoryTree, text));
    private Task<IEnumerable<int?>> SearchLocations(string? text, CancellationToken _) => Task.FromResult(Search(locationTree, text));

    /// <summary>Alle Suchwörter müssen im Pfad vorkommen: "halb trans" findet "Halbleiter › Transistoren".</summary>
    private static IEnumerable<int?> Search<T>(List<TreeEntry<T>> tree, string? text) where T : ITreeNode
    {
        var terms = (text ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return tree.Where(e => terms.All(t => e.Path.Contains(t, StringComparison.CurrentCultureIgnoreCase)))
            .Select(e => (int?)e.Node.Id);
    }

    private static List<string> Distinct(IEnumerable<string?> values) =>
        values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v!.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .Order(StringComparer.CurrentCultureIgnoreCase).ToList();

    private static void Remember(List<string> list, string? v)
    {
        if (string.IsNullOrWhiteSpace(v) || list.Contains(v, StringComparer.CurrentCultureIgnoreCase)) return;
        list.Add(v);
        list.Sort(StringComparer.CurrentCultureIgnoreCase);
    }

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static bool SameText(string? a, string? b) =>
        string.Equals(Clean(a) ?? "", Clean(b) ?? "", StringComparison.CurrentCultureIgnoreCase);

    // ---------- Eingabe ----------

    private void OnCategoryChanged(int? id)
    {
        categoryId = id;
        applicable = Attributes.For(id, categories, definitions);
    }

    private void TogglePin(string key)
    {
        if (!pinned.Remove(key)) pinned.Add(key);
    }

    private void OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ResetRow();
    }

    /// <summary>Leert alle nicht angepinnten Felder, baut die Zeile neu auf und setzt danach den Fokus.</summary>
    private void ResetRow()
    {
        rowVersion++;
        focusRowPending = true;
        if (!pinned.Contains(K.Name)) name = null;
        if (!pinned.Contains(K.Value)) value = null;
        if (!pinned.Contains(K.Package)) packageId = null;
        if (!pinned.Contains(K.Quantity)) quantity = 1;
        if (!pinned.Contains(K.MinQuantity)) minQuantity = 0;
        if (!pinned.Contains(K.Description)) description = null;
        if (!pinned.Contains(K.Manufacturer)) manufacturer = null;
        if (!pinned.Contains(K.PartNumber)) partNumber = null;
        foreach (var id in attributeInputs.Keys.ToList())
            if (!pinned.Contains(AttrKey(id))) attributeInputs.Remove(id);
    }

    /// <summary>Springt in das erste nicht angepinnte Feld – bei einer Widerstandsserie also direkt in "Wert".</summary>
    private async Task FocusFirstFreeFieldAsync()
    {
        var target = PinOptions.Select(o => o.Key).FirstOrDefault(k => !pinned.Contains(k)) ?? K.Name;
        switch (target)
        {
            case K.Name: await nameField.FocusAsync(); break;
            case K.Value: await valueField.FocusAsync(); break;
            case K.Package: await packageField.FocusAsync(); break;
            case K.Quantity: await quantityField.FocusAsync(); await quantityField.SelectAsync(); break;
            case K.MinQuantity: await minQuantityField.FocusAsync(); await minQuantityField.SelectAsync(); break;
            case K.Description: await descriptionField.FocusAsync(); break;
            case K.Manufacturer: await manufacturerField.FocusAsync(); break;
            case K.PartNumber: await partNumberField.FocusAsync(); break;
            default:
                if (attributeFields is not null && int.TryParse(target[2..], out var defId))
                    await attributeFields.FocusAsync(defId);
                break;
        }
    }

    private async Task SaveAsync()
    {
        if (saving) return;
        var cleanName = Clean(name);
        if (cleanName is null)
        {
            Snackbar.Add("Bitte einen Namen eingeben.", Severity.Warning);
            await nameField.FocusAsync();
            return;
        }

        var (stored, error) = Attributes.Validate(applicable, attributeInputs);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Gibt es das Bauteil am selben Lagerort schon? Dann nur den Bestand erhöhen.
            var candidates = await db.Parts.Where(p => p.StorageLocationId == locationId && p.PackageId == packageId).ToListAsync();
            var existing = candidates.FirstOrDefault(p => SameText(p.Name, cleanName) && SameText(p.Value, value));
            var packageName = packages.FirstOrDefault(p => p.Id == packageId)?.Name;
            var attributeSummary = string.Join(" · ", applicable
                .Where(d => stored.ContainsKey(d.Id))
                .Select(d => $"{d.Name} {Attributes.Display(d, stored[d.Id])}"));

            LogEntry entry;
            if (existing is not null)
            {
                existing.Quantity += quantity;
                if (minQuantity > 0) existing.MinQuantity = minQuantity;
                await db.SaveChangesAsync();
                entry = new LogEntry(existing.Id, false, existing.Name, existing.Value, packageName, attributeSummary,
                    quantity, existing.Quantity, existing.StorageLocationId);
                Snackbar.Add($"\"{existing.Name} {existing.Value}\" gab es schon – Bestand jetzt {existing.Quantity}.", Severity.Info);
            }
            else
            {
                var part = new Part
                {
                    Name = cleanName,
                    Value = Clean(value),
                    PackageId = packageId,
                    Quantity = quantity,
                    MinQuantity = minQuantity,
                    Description = Clean(description),
                    Manufacturer = Clean(manufacturer),
                    PartNumber = Clean(partNumber),
                    CategoryId = categoryId,
                    StorageLocationId = locationId,
                };
                db.Parts.Add(part);
                await db.SaveChangesAsync();
                await Attributes.ReplaceValuesAsync(db, part.Id, stored);
                entry = new LogEntry(part.Id, true, part.Name, part.Value, packageName, attributeSummary,
                    part.Quantity, part.Quantity, part.StorageLocationId);

                Remember(knownNames, part.Name);
                Remember(knownValues, part.Value);
                Remember(knownManufacturers, part.Manufacturer);
            }

            log.Insert(0, entry);
            ResetRow();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UndoAsync(LogEntry entry)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (entry.Created)
        {
            await db.Parts.Where(p => p.Id == entry.PartId).ExecuteDeleteAsync();
            Snackbar.Add($"\"{entry.Name} {entry.Value}\" wieder entfernt.", Severity.Info);
        }
        else
        {
            var part = await db.Parts.FindAsync(entry.PartId);
            if (part is not null)
            {
                part.Quantity = Math.Max(0, part.Quantity - entry.Amount);
                await db.SaveChangesAsync();
                Snackbar.Add($"Bestand von \"{part.Name} {part.Value}\" zurück auf {part.Quantity}.", Severity.Info);
            }
        }
        log.Remove(entry);
        focusRowPending = true;
    }
}
