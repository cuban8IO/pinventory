@page "/categories"

<PageTitle>Kategorien · Pinventory</PageTitle>

<h1 class="h3 mb-3">Kategorien</h1>
<p class="text-muted">Kategorien lassen sich beliebig verschachteln, z.B. <em>Halbleiter › Transistoren</em>.
    Ein Klick auf den Namen zeigt alle Bauteile darin (inkl. Unterkategorien).</p>

<TreeManager TNode="Category" Singular="Kategorie" FilterQueryName="category" LoadCounts="LoadCounts" />

@code {
    private static Task<Dictionary<int, int>> LoadCounts(PinventoryDbContext db) =>
        db.Parts.Where(p => p.CategoryId != null)
            .GroupBy(p => p.CategoryId!.Value)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);
}
