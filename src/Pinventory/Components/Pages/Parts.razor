@page "/parts"
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Bauteile · Pinventory</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Bauteile</MudText>
    <div class="d-flex gap-2">
        <MudButton Href="parts/new" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Neues Bauteil
        </MudButton>
        <MudButton Href="@QuickAddHref" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt">
            Schnellerfassung
        </MudButton>
    </div>
</div>

<MudPaper Outlined="true" Class="pa-3 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" lg="4">
            <MudTextField T="string" Value="search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="150"
                          Placeholder="Suchen: Name, Wert, Bauform, Eigenschaften, Hersteller …" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" AutoFocus="true" />
        </MudItem>
        <MudItem xs="6" lg="3">
            <MudSelect T="int?" Value="categoryId" ValueChanged="OnCategoryChanged" Label="Kategorie" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true" Dense="true" ToStringFunc="CategoryLabel">
                @foreach (var c in categoryTree)
                {
                    <MudSelectItem T="int?" Value="c.Node.Id">
                        <span style="padding-left: @(c.Depth * 1.25)rem">@c.Node.Name</span>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" lg="3">
            <MudSelect T="int?" Value="locationId" ValueChanged="OnLocationChanged" Label="Lagerort" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true" Dense="true" ToStringFunc="LocationLabel">
                @foreach (var l in locationTree)
                {
                    <MudSelectItem T="int?" Value="l.Node.Id">
                        <span style="padding-left: @(l.Depth * 1.25)rem">@l.Node.Name</span>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" lg="2" Class="d-flex align-center">
            <MudSwitch T="bool" Value="lowOnly" ValueChanged="OnLowOnlyChanged" Color="Color.Error" Label="Nachbestellen" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (parts is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex align-center gap-2 mb-2">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @filtered.Count von @parts.Count Bauteilen · @filtered.Sum(p => p.Quantity).ToString("N0") Stück
        </MudText>
        @if (IsFiltered)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ResetFilter">
                Filter zurücksetzen
            </MudButton>
        }
        @if (columnDefinitions.Count > 0)
        {
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" Style="vertical-align: middle" />
                Eigenschaften als Spalten – zum Sortieren auf die Überschrift klicken
            </MudText>
        }
    </div>

    @* Neuer Key bei Kategoriewechsel: die Eigenschafts-Spalten werden neu aufgebaut. *@
    <MudDataGrid T="Part" @key="categoryId" Items="filtered" Dense="true" Hover="true" Outlined="true" Elevation="0"
                 SortMode="SortMode.Single" RowsPerPage="50" RowClick="OnRowClick" RowStyle="cursor: pointer"
                 HorizontalScrollbar="true">
        <Columns>
            <PropertyColumn Property="p => p.Name" Title="Name" InitialDirection="SortDirection.Ascending">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.Name</b></MudText>
                    @if (!string.IsNullOrEmpty(context.Item.Description))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block">@context.Item.Description</MudText>
                    }
                    @if (columnDefinitions.Count == 0 && AttributeSummary(context.Item) is { Length: > 0 } summary)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary" Style="display:block">@summary</MudText>
                    }
                    @if (!string.IsNullOrEmpty(context.Item.Manufacturer) || !string.IsNullOrEmpty(context.Item.PartNumber))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block">@context.Item.Manufacturer @context.Item.PartNumber</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="p => p.Value" Title="Wert" />
            <TemplateColumn T="Part" Title="Bauform" SortBy="p => PackageName(p)">
                <CellTemplate><MudText Typo="Typo.body2">@PackageName(context.Item)</MudText></CellTemplate>
            </TemplateColumn>

            @foreach (var def in columnDefinitions)
            {
                var d = def;
                <TemplateColumn T="Part" Title="@(d.Unit is null ? d.Name : $"{d.Name} [{d.Unit}]")"
                                SortBy="p => Attributes.SortKey(d, ValueOf(p, d))">
                    <CellTemplate><MudText Typo="Typo.body2">@Attributes.ToInput(d, ValueOf(context.Item, d))</MudText></CellTemplate>
                </TemplateColumn>
            }

            @if (columnDefinitions.Count == 0)
            {
                <TemplateColumn T="Part" Title="Kategorie" SortBy="p => CategoryPath(p) ?? string.Empty">
                    <CellTemplate><MudText Typo="Typo.body2">@CategoryPath(context.Item)</MudText></CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn T="Part" Title="Lagerort" SortBy="p => LocationPath(p) ?? string.Empty">
                <CellTemplate><MudText Typo="Typo.body2">@LocationPath(context.Item)</MudText></CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="Part" Title="Menge" SortBy="p => p.Quantity" HeaderStyle="text-align: right" CellStyle="text-align: right; white-space: nowrap">
                <CellTemplate>
                    <div class="d-inline-flex align-center" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="@(context.Item.Quantity == 0)"
                                       OnClick="() => ChangeQuantityAsync(context.Item, -1)" aria-label="Eins entnehmen" />
                        <MudChip T="string" Size="Size.Small" Class="qty-value" Color="QuantityColor(context.Item)"
                                 Variant="@(QuantityColor(context.Item) == Color.Default ? Variant.Outlined : Variant.Filled)">
                            @context.Item.Quantity
                        </MudChip>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       OnClick="() => ChangeQuantityAsync(context.Item, +1)" aria-label="Eins hinzufügen" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            @if (parts.Count == 0)
            {
                <MudText>Noch keine Bauteile eingelagert. <MudLink Href="parts/quick">Jetzt einlagern</MudLink>.</MudText>
            }
            else
            {
                <MudText>Keine Treffer für diese Filter.</MudText>
            }
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="Part" PageSizeOptions="[25, 50, 100, 250]" RowsPerPageString="Zeilen pro Seite:"
                              InfoFormat="{first_item}–{last_item} von {all_items}" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QueryText { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public int? QueryCategory { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? QueryLocation { get; set; }
    [SupplyParameterFromQuery(Name = "low")] public bool QueryLow { get; set; }

    private List<Part>? parts;
    private List<Part> filtered = [];
    private List<TreeEntry<Category>> categoryTree = [];
    private List<TreeEntry<StorageLocation>> locationTree = [];
    private List<Category> categories = [];
    private List<StorageLocation> locations = [];
    private Dictionary<int, string> categoryPaths = [];
    private Dictionary<int, string> locationPaths = [];
    private Dictionary<int, string> packageNames = [];
    private List<AttributeDefinition> definitions = [];
    private Dictionary<int, AttributeDefinition> definitionsById = [];

    /// <summary>Bauteil-Id → (Definition-Id → gespeicherter Wert).</summary>
    private Dictionary<int, Dictionary<int, string>> attributeValues = [];

    /// <summary>Eigenschaften der gefilterten Kategorie – werden als Spalten gezeigt.</summary>
    private List<AttributeDefinition> columnDefinitions = [];

    private string search = "";
    private int? categoryId;
    private int? locationId;
    private bool lowOnly;

    private bool IsFiltered => search.Length > 0 || categoryId is not null || locationId is not null || lowOnly;

    // Aktive Filter als Vorbelegung an die Schnellerfassung weitergeben.
    private string QuickAddHref => $"parts/quick?category={categoryId}&location={locationId}";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.Categories.AsNoTracking().ToListAsync();
        locations = await db.StorageLocations.AsNoTracking().ToListAsync();
        packageNames = await db.Packages.AsNoTracking().ToDictionaryAsync(p => p.Id, p => p.Name);
        definitions = await db.AttributeDefinitions.AsNoTracking().ToListAsync();
        definitionsById = definitions.ToDictionary(d => d.Id);
        parts = await db.Parts.AsNoTracking().ToListAsync();

        attributeValues = (await db.PartAttributeValues.AsNoTracking().ToListAsync())
            .GroupBy(v => v.PartId)
            .ToDictionary(g => g.Key, g => g.ToDictionary(v => v.AttributeDefinitionId, v => v.Value));

        categoryTree = Tree.Flatten(categories);
        locationTree = Tree.Flatten(locations);
        categoryPaths = categoryTree.ToDictionary(e => e.Node.Id, e => e.Path);
        locationPaths = locationTree.ToDictionary(e => e.Node.Id, e => e.Path);
    }

    protected override void OnParametersSet()
    {
        // Filter aus der URL übernehmen (z.B. Link von der Übersicht oder den Kategorien).
        search = QueryText ?? "";
        categoryId = QueryCategory;
        locationId = QueryLocation;
        lowOnly = QueryLow;
        columnDefinitions = Attributes.For(categoryId, categories, definitions);
        ApplyFilter();
    }

    private string? CategoryPath(Part p) => p.CategoryId is int id ? categoryPaths.GetValueOrDefault(id) : null;
    private string? LocationPath(Part p) => p.StorageLocationId is int id ? locationPaths.GetValueOrDefault(id) : null;
    private string PackageName(Part p) => p.PackageId is int id ? packageNames.GetValueOrDefault(id) ?? "" : "";
    private string CategoryLabel(int? id) => id is int i ? categoryPaths.GetValueOrDefault(i) ?? "" : "";
    private string LocationLabel(int? id) => id is int i ? locationPaths.GetValueOrDefault(i) ?? "" : "";

    private string? ValueOf(Part p, AttributeDefinition d) =>
        attributeValues.TryGetValue(p.Id, out var values) ? values.GetValueOrDefault(d.Id) : null;

    /// <summary>Kurzübersicht der Eigenschaften, z.B. "U_DS 60 V · R_DS(on) 28 mΩ".</summary>
    private string AttributeSummary(Part p)
    {
        if (!attributeValues.TryGetValue(p.Id, out var values)) return "";
        return string.Join(" · ", Attributes.For(p.CategoryId, categories, definitions)
            .Where(d => values.ContainsKey(d.Id))
            .Select(d => $"{d.Name} {Attributes.Display(d, values[d.Id])}"));
    }

    private static Color QuantityColor(Part p) =>
        p.IsLowStock ? Color.Error : p.Quantity == 0 ? Color.Warning : Color.Default;

    private void OnSearchChanged(string? value) { search = value ?? ""; ApplyFilter(); }
    private void OnLocationChanged(int? value) { locationId = value; ApplyFilter(); }
    private void OnLowOnlyChanged(bool value) { lowOnly = value; ApplyFilter(); }

    private void OnCategoryChanged(int? value)
    {
        categoryId = value;
        columnDefinitions = Attributes.For(categoryId, categories, definitions);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (parts is null) return;
        IEnumerable<Part> q = parts;

        if (categoryId is int cid)
        {
            var ids = Tree.SelfAndDescendants(categories, cid);
            q = q.Where(p => p.CategoryId is int id && ids.Contains(id));
        }
        if (locationId is int lid)
        {
            var ids = Tree.SelfAndDescendants(locations, lid);
            q = q.Where(p => p.StorageLocationId is int id && ids.Contains(id));
        }
        if (lowOnly)
        {
            q = q.Where(p => p.IsLowStock);
        }

        // Jedes Suchwort muss in irgendeinem Feld vorkommen: "10k 0805" findet 10kΩ-Widerstände in 0805.
        var terms = search.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (terms.Length > 0)
        {
            q = q.Where(p =>
            {
                var attributes = attributeValues.TryGetValue(p.Id, out var values)
                    ? string.Join(' ', values.Select(v => definitionsById.TryGetValue(v.Key, out var d) ? $"{d.Name} {Attributes.Display(d, v.Value)}" : v.Value))
                    : "";
                var haystack = string.Join(' ', p.Name, p.Description, p.Value, PackageName(p), p.Manufacturer,
                    p.PartNumber, p.Notes, CategoryPath(p), LocationPath(p), attributes);
                return terms.All(t => haystack.Contains(t, StringComparison.CurrentCultureIgnoreCase));
            });
        }

        filtered = q.ToList();
    }

    private void ResetFilter()
    {
        search = "";
        categoryId = null;
        locationId = null;
        lowOnly = false;
        columnDefinitions = [];
        ApplyFilter();
    }

    private void OnRowClick(DataGridRowClickEventArgs<Part> args) => Nav.NavigateTo($"parts/{args.Item.Id}");

    private async Task ChangeQuantityAsync(Part part, int delta)
    {
        var newQuantity = Math.Max(0, part.Quantity + delta);
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Parts.Where(p => p.Id == part.Id)
            .ExecuteUpdateAsync(s => s
                .SetProperty(p => p.Quantity, newQuantity)
                .SetProperty(p => p.UpdatedAt, DateTime.UtcNow));
        part.Quantity = newQuantity;
        if (lowOnly) ApplyFilter();
    }
}
