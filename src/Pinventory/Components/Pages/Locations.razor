@page "/locations"

<PageTitle>Lagerorte · Pinventory</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Lagerorte</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Bilde deine Werkstatt ab, z.B. <i>Regal A › Sortimentskasten 2 › Fach 14</i>.
    Ein Klick auf den Namen zeigt, was dort liegt.
</MudText>

<TreeManager TNode="StorageLocation" Singular="Lagerort" FilterQueryName="location" LoadCounts="LoadCounts" />

@code {
    private static Task<Dictionary<int, int>> LoadCounts(PinventoryDbContext db) =>
        db.Parts.Where(p => p.StorageLocationId != null)
            .GroupBy(p => p.StorageLocationId!.Value)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);
}
