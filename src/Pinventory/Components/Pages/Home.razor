@page "/"
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Pinventory</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Übersicht</MudText>

<form @onsubmit="Search" style="max-width: 44rem" class="mb-6">
    <MudTextField @bind-Value="search" Variant="Variant.Outlined" Placeholder="Was suchst du? z.B. 10k 0805, BC547, ESP32 …"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="Search"
                  Immediate="true" AutoFocus="true" />
</form>

@if (loaded)
{
    <MudGrid Spacing="3" Class="mb-6">
        <StatTile Label="Bauteil-Typen" Value="@partCount.ToString("N0")" Icon="@Icons.Material.Filled.Inventory2" Href="parts" />
        <StatTile Label="Stück gesamt" Value="@totalQuantity.ToString("N0")" Icon="@Icons.Material.Filled.Numbers" Href="parts" />
        <StatTile Label="Nachbestellen" Value="@lowStock.Count.ToString()" Icon="@Icons.Material.Filled.ShoppingCart"
                  Href="parts?low=true" Color="@(lowStock.Count > 0 ? Color.Error : Color.Default)" />
        <StatTile Label="Lagerorte" Value="@locationCount.ToString()" Icon="@Icons.Material.Filled.Warehouse" Href="locations" />
    </MudGrid>

    <MudGrid Spacing="4">
        <MudItem xs="12" lg="7">
            <MudText Typo="Typo.h6" Class="mb-2">Kategorien</MudText>
            <MudGrid Spacing="2">
                @foreach (var c in topCategories)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Class="category-card pa-3" Outlined="true" @onclick="@(() => Nav.NavigateTo($"parts?category={c.Category.Id}"))">
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.subtitle1"><b>@c.Category.Name</b></MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(c.Count > 0 ? Color.Primary : Color.Default)">@c.Count</MudChip>
                            </div>
                            @if (c.Children.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                                    @string.Join(" · ", c.Children)
                                </MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <MudItem xs="12" lg="5">
            @if (lowStock.Count > 0)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Nachbestellen</MudText>
                <MudPaper Outlined="true" Class="mb-6">
                    <MudList T="Part" Dense="true">
                        @foreach (var p in lowStock.Take(10))
                        {
                            <MudListItem T="Part" Href="@($"parts/{p.Id}")" Icon="@Icons.Material.Filled.Warning" IconColor="Color.Error">
                                <div class="d-flex justify-space-between align-center">
                                    <span>@p.Name <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">@p.Value @p.Package</MudText></span>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">@p.Quantity / @p.MinQuantity</MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }

            <MudText Typo="Typo.h6" Class="mb-2">Zuletzt geändert</MudText>
            @if (recent.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Noch nichts eingelagert. <MudLink Href="parts/new">Erstes Bauteil anlegen</MudLink>
                </MudAlert>
            }
            else
            {
                <MudPaper Outlined="true">
                    <MudList T="Part" Dense="true">
                        @foreach (var p in recent)
                        {
                            <MudListItem T="Part" Href="@($"parts/{p.Id}")">
                                <div class="d-flex justify-space-between align-center">
                                    <span>@p.Name <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">@p.Value @p.Package</MudText></span>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@p.Quantity Stk.</MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
else
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

@code {
    private record CategorySummary(Category Category, int Count, List<string> Children);

    private string search = "";
    private bool loaded;
    private int partCount;
    private int totalQuantity;
    private int locationCount;
    private List<Part> lowStock = [];
    private List<Part> recent = [];
    private List<CategorySummary> topCategories = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var parts = await db.Parts.AsNoTracking().ToListAsync();
        var categories = await db.Categories.AsNoTracking().ToListAsync();
        locationCount = await db.StorageLocations.CountAsync();

        partCount = parts.Count;
        totalQuantity = parts.Sum(p => p.Quantity);
        lowStock = parts.Where(p => p.IsLowStock).OrderBy(p => p.Name).ToList();
        recent = parts.OrderByDescending(p => p.UpdatedAt).Take(8).ToList();

        var perCategory = parts.Where(p => p.CategoryId != null)
            .GroupBy(p => p.CategoryId!.Value).ToDictionary(g => g.Key, g => g.Count());

        topCategories = categories.Where(c => c.ParentId == null)
            .OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase)
            .Select(c => new CategorySummary(
                c,
                Tree.SelfAndDescendants(categories, c.Id).Sum(id => perCategory.GetValueOrDefault(id)),
                categories.Where(x => x.ParentId == c.Id).Select(x => x.Name)
                    .Order(StringComparer.CurrentCultureIgnoreCase).ToList()))
            .ToList();

        loaded = true;
    }

    private void Search() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(search) ? "parts" : $"parts?q={Uri.EscapeDataString(search.Trim())}");
}
