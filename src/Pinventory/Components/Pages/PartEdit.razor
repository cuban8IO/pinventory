@page "/parts/new"
@page "/parts/{Id:int}"
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Neues Bauteil" : model?.Name) · Pinventory</PageTitle>

<MudButton Href="parts" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mb-1">
    Bauteilliste
</MudButton>
<MudText Typo="Typo.h4" Class="mb-4">@(IsNew ? "Neues Bauteil einlagern" : "Bauteil bearbeiten")</MudText>

@if (notFound)
{
    <MudAlert Severity="Severity.Warning">Dieses Bauteil gibt es nicht (mehr).</MudAlert>
}
else if (model is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <MudPaper Outlined="true" Class="pa-4" Style="max-width: 64rem">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="model.Name" For="() => model.Name" Label="Name" Required="true"
                                  Placeholder="z.B. Widerstand 10kΩ, BC547, ATmega328P" Variant="Variant.Outlined" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int?" @bind-Value="model.CategoryId" Label="Kategorie" Variant="Variant.Outlined"
                               Clearable="true" Dense="true" ToStringFunc="id => Label(categories, id)">
                        @foreach (var c in categories)
                        {
                            <MudSelectItem T="int?" Value="c.Node.Id">
                                <span style="padding-left: @(c.Depth * 1.25)rem">@c.Node.Name</span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" @bind-Value="model.Value" Label="Wert" Placeholder="10kΩ, 100nF, 3,3V"
                                     SearchFunc="(t, ct) => Suggest(knownValues, t)" CoerceText="false" CoerceValue="true"
                                     Variant="Variant.Outlined" MaxItems="20" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" @bind-Value="model.Package" Label="Bauform / Gehäuse" Placeholder="0805, TO-92, DIP-8"
                                     SearchFunc="(t, ct) => Suggest(knownPackages, t)" CoerceText="false" CoerceValue="true"
                                     Variant="Variant.Outlined" MaxItems="20" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int?" @bind-Value="model.StorageLocationId" Label="Lagerort" Variant="Variant.Outlined"
                               Clearable="true" Dense="true" ToStringFunc="id => Label(locations, id)"
                               HelperText="@(locations.Count == 0 ? "Noch keine Lagerorte angelegt" : null)">
                        @foreach (var l in locations)
                        {
                            <MudSelectItem T="int?" Value="l.Node.Id">
                                <span style="padding-left: @(l.Depth * 1.25)rem">@l.Node.Name</span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="6" md="3">
                    <MudNumericField T="int" @bind-Value="model.Quantity" For="() => model.Quantity" Label="Menge" Min="0" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="int" @bind-Value="model.MinQuantity" For="() => model.MinQuantity" Label="Mindestbestand" Min="0"
                                     HelperText="0 = keine Warnung" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="string" @bind-Value="model.Manufacturer" Label="Hersteller"
                                     SearchFunc="(t, ct) => Suggest(knownManufacturers, t)" CoerceText="false" CoerceValue="true"
                                     Variant="Variant.Outlined" MaxItems="20" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="model.PartNumber" For="() => model.PartNumber" Label="Teilenummer (MPN)" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="model.Description" For="() => model.Description" Label="Kurzbeschreibung"
                                  Placeholder="z.B. NPN-Transistor 45V 100mA" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="model.DatasheetUrl" For="() => model.DatasheetUrl" Label="Datenblatt-Link" Placeholder="https://…"
                                  Variant="Variant.Outlined" Immediate="true"
                                  Adornment="@(string.IsNullOrWhiteSpace(model.DatasheetUrl) ? Adornment.None : Adornment.End)"
                                  AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentAriaLabel="Datenblatt öffnen"
                                  OnAdornmentClick="OpenDatasheet" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="model.Notes" For="() => model.Notes" Label="Notizen" Lines="3" Sizing="InputSizing.Auto" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" Class="d-flex flex-wrap gap-2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save" OnClick="() => addAnother = false">
                        Speichern
                    </MudButton>
                    <MudTooltip Text="Speichert und öffnet ein neues Formular mit gleicher Kategorie und gleichem Lagerort">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="() => addAnother = true">
                            Speichern &amp; nächstes
                        </MudButton>
                    </MudTooltip>
                    <MudButton Href="parts" Variant="Variant.Text">Abbrechen</MudButton>
                    @if (!IsNew)
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="Duplicate">Duplizieren</MudButton>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">
                            Löschen
                        </MudButton>
                    }
                </MudItem>
                @if (!IsNew)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Angelegt @model.CreatedAt.ToLocalTime().ToString("g") · zuletzt geändert @model.UpdatedAt.ToLocalTime().ToString("g")
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    // Vorbelegung für neue Bauteile, z.B. nach "Speichern & nächstes".
    [SupplyParameterFromQuery(Name = "category")] public int? PresetCategory { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? PresetLocation { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool IsNew => Id is null;
    private Part? model;
    private bool notFound;
    private bool addAnother;

    // Wird über einen Seitenwechsel hinweg übergeben (Duplizieren).
    private Part? pendingCopy;

    private List<TreeEntry<Category>> categories = [];
    private List<TreeEntry<StorageLocation>> locations = [];
    private List<string> knownValues = [];
    private List<string> knownPackages = [];
    private List<string> knownManufacturers = [];

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        await using var db = await DbFactory.CreateDbContextAsync();

        categories = Tree.Flatten(await db.Categories.AsNoTracking().ToListAsync());
        locations = Tree.Flatten(await db.StorageLocations.AsNoTracking().ToListAsync());

        // Vorschläge aus bereits erfassten Bauteilen.
        var all = await db.Parts.AsNoTracking()
            .Select(p => new { p.Value, p.Package, p.Manufacturer }).ToListAsync();
        knownValues = Distinct(all.Select(p => p.Value));
        knownPackages = Distinct(all.Select(p => p.Package));
        knownManufacturers = Distinct(all.Select(p => p.Manufacturer));

        if (IsNew)
        {
            model = pendingCopy ?? new Part { CategoryId = PresetCategory, StorageLocationId = PresetLocation };
            pendingCopy = null;
        }
        else
        {
            model = await db.Parts.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id);
            notFound = model is null;
        }
    }

    private static string Label<T>(List<TreeEntry<T>> entries, int? id) where T : ITreeNode =>
        id is int i ? entries.FirstOrDefault(e => e.Node.Id == i)?.Path ?? "" : "";

    private static List<string> Distinct(IEnumerable<string?> values) =>
        values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v!.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .Order(StringComparer.CurrentCultureIgnoreCase).ToList();

    private static Task<IEnumerable<string>> Suggest(List<string> source, string? text) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? source.AsEnumerable()
            : source.Where(v => v.Contains(text, StringComparison.CurrentCultureIgnoreCase)));

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task OpenDatasheet()
    {
        if (!string.IsNullOrWhiteSpace(model?.DatasheetUrl))
            await JS.InvokeVoidAsync("open", model.DatasheetUrl, "_blank", "noopener");
    }

    private async Task SaveAsync()
    {
        if (model is null) return;
        model.Name = model.Name.Trim();
        model.Description = Clean(model.Description);
        model.Value = Clean(model.Value);
        model.Package = Clean(model.Package);
        model.Manufacturer = Clean(model.Manufacturer);
        model.PartNumber = Clean(model.PartNumber);
        model.DatasheetUrl = Clean(model.DatasheetUrl);
        model.Notes = Clean(model.Notes);

        await using var db = await DbFactory.CreateDbContextAsync();
        if (IsNew) db.Parts.Add(model);
        else db.Parts.Update(model);
        await db.SaveChangesAsync();

        Snackbar.Add($"\"{model.Name}\" gespeichert.", Severity.Success);

        if (!addAnother)
        {
            Nav.NavigateTo("parts");
        }
        else if (IsNew)
        {
            // Bereits auf "Neu" → Formular direkt zurücksetzen, Kategorie & Lagerort behalten.
            model = new Part { CategoryId = model.CategoryId, StorageLocationId = model.StorageLocationId };
        }
        else
        {
            Nav.NavigateTo($"parts/new?category={model.CategoryId}&location={model.StorageLocationId}");
        }
    }

    private void Duplicate()
    {
        if (model is null) return;
        pendingCopy = new Part
        {
            Name = model.Name + " (Kopie)",
            Description = model.Description,
            Value = model.Value,
            Package = model.Package,
            Manufacturer = model.Manufacturer,
            PartNumber = model.PartNumber,
            MinQuantity = model.MinQuantity,
            DatasheetUrl = model.DatasheetUrl,
            Notes = model.Notes,
            CategoryId = model.CategoryId,
            StorageLocationId = model.StorageLocationId,
        };
        Snackbar.Add("Kopie erstellt – Werte anpassen und speichern.", Severity.Info);
        Nav.NavigateTo("parts/new");
    }

    private async Task DeleteAsync()
    {
        if (model is null || IsNew) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Bauteil löschen",
            $"\"{model.Name}\" wirklich löschen? Das lässt sich nicht rückgängig machen.",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Parts.Where(p => p.Id == model.Id).ExecuteDeleteAsync();
        Snackbar.Add($"\"{model.Name}\" gelöscht.", Severity.Info);
        Nav.NavigateTo("parts");
    }
}
