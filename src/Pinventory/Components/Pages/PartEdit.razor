@page "/parts/new"
@page "/parts/{Id:int}"
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "Neues Bauteil" : model?.Name) · Pinventory</PageTitle>

<div class="mb-3">
    <a href="parts" class="small">← zur Bauteilliste</a>
    <h1 class="h3 mt-1">@(IsNew ? "Neues Bauteil einlagern" : "Bauteil bearbeiten")</h1>
</div>

@if (notFound)
{
    <div class="alert alert-warning">Dieses Bauteil gibt es nicht (mehr).</div>
}
else if (model is null)
{
    <p><em>Lade …</em></p>
}
else
{
    @if (savedMessage is not null)
    {
        <div class="alert alert-success py-2">@savedMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="row g-3" style="max-width: 60rem">
            <div class="col-md-8">
                <label class="form-label">Name *</label>
                <InputText class="form-control" @bind-Value="model.Name" placeholder="z.B. Widerstand 10kΩ, BC547, ATmega328P" autofocus />
            </div>
            <div class="col-md-4">
                <label class="form-label">Kategorie</label>
                <InputSelect class="form-select" @bind-Value="model.CategoryId">
                    <option value="">– keine –</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Node.Id">@c.Path</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-4">
                <label class="form-label">Wert</label>
                <InputText class="form-control" @bind-Value="model.Value" placeholder="10kΩ, 100nF, 3,3V" list="dl-values" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Bauform / Gehäuse</label>
                <InputText class="form-control" @bind-Value="model.Package" placeholder="0805, TO-92, DIP-8" list="dl-packages" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Lagerort</label>
                <InputSelect class="form-select" @bind-Value="model.StorageLocationId">
                    <option value="">– keiner –</option>
                    @foreach (var l in locations)
                    {
                        <option value="@l.Node.Id">@l.Path</option>
                    }
                </InputSelect>
                @if (locations.Count == 0)
                {
                    <div class="form-text"><a href="locations">Lagerorte anlegen</a></div>
                }
            </div>

            <div class="col-md-3">
                <label class="form-label">Menge</label>
                <InputNumber class="form-control" @bind-Value="model.Quantity" min="0" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Mindestbestand</label>
                <InputNumber class="form-control" @bind-Value="model.MinQuantity" min="0" />
                <div class="form-text">0 = keine Warnung</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Hersteller</label>
                <InputText class="form-control" @bind-Value="model.Manufacturer" list="dl-manufacturers" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Teilenummer (MPN)</label>
                <InputText class="form-control" @bind-Value="model.PartNumber" />
            </div>

            <div class="col-12">
                <label class="form-label">Kurzbeschreibung</label>
                <InputText class="form-control" @bind-Value="model.Description" placeholder="z.B. NPN-Transistor 45V 100mA" />
            </div>
            <div class="col-12">
                <label class="form-label">Datenblatt-Link</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="model.DatasheetUrl" placeholder="https://…" />
                    @if (!string.IsNullOrWhiteSpace(model.DatasheetUrl))
                    {
                        <a class="btn btn-outline-secondary" href="@model.DatasheetUrl" target="_blank" rel="noopener">Öffnen</a>
                    }
                </div>
            </div>
            <div class="col-12">
                <label class="form-label">Notizen</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" />
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" @onclick="() => addAnother = false">Speichern</button>
                <button type="submit" class="btn btn-outline-primary" @onclick="() => addAnother = true"
                        title="Speichert und öffnet ein neues Formular mit gleicher Kategorie und gleichem Lagerort">
                    Speichern &amp; nächstes
                </button>
                <a href="parts" class="btn btn-outline-secondary">Abbrechen</a>
                @if (!IsNew)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="Duplicate">Duplizieren</button>
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="DeleteAsync">Löschen</button>
                }
            </div>
            @if (!IsNew)
            {
                <div class="col-12 small text-muted">
                    Angelegt @model.CreatedAt.ToLocalTime().ToString("g") · zuletzt geändert @model.UpdatedAt.ToLocalTime().ToString("g")
                </div>
            }
        </div>
    </EditForm>

    <datalist id="dl-values">@foreach (var v in knownValues) { <option value="@v"></option> }</datalist>
    <datalist id="dl-packages">@foreach (var v in knownPackages) { <option value="@v"></option> }</datalist>
    <datalist id="dl-manufacturers">@foreach (var v in knownManufacturers) { <option value="@v"></option> }</datalist>
}

@code {
    [Parameter] public int? Id { get; set; }

    // Vorbelegung für neue Bauteile, z.B. nach "Speichern & nächstes".
    [SupplyParameterFromQuery(Name = "category")] public int? PresetCategory { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? PresetLocation { get; set; }

    private bool IsNew => Id is null;
    private Part? model;
    private bool notFound;
    private bool addAnother;
    private string? savedMessage;

    // Werte, die über einen Seitenwechsel hinweg übergeben werden.
    private Part? pendingCopy;
    private string? pendingMessage;

    private List<TreeEntry<Category>> categories = [];
    private List<TreeEntry<StorageLocation>> locations = [];
    private List<string> knownValues = [];
    private List<string> knownPackages = [];
    private List<string> knownManufacturers = [];

    protected override async Task OnParametersSetAsync()
    {
        notFound = false;
        savedMessage = pendingMessage;
        pendingMessage = null;
        await using var db = await DbFactory.CreateDbContextAsync();

        categories = Tree.Flatten(await db.Categories.AsNoTracking().ToListAsync());
        locations = Tree.Flatten(await db.StorageLocations.AsNoTracking().ToListAsync());

        // Vorschläge aus bereits erfassten Bauteilen.
        var all = await db.Parts.AsNoTracking()
            .Select(p => new { p.Value, p.Package, p.Manufacturer }).ToListAsync();
        knownValues = Distinct(all.Select(p => p.Value));
        knownPackages = Distinct(all.Select(p => p.Package));
        knownManufacturers = Distinct(all.Select(p => p.Manufacturer));

        if (IsNew)
        {
            model = pendingCopy ?? new Part { CategoryId = PresetCategory, StorageLocationId = PresetLocation };
            pendingCopy = null;
        }
        else
        {
            model = await db.Parts.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id);
            notFound = model is null;
        }
    }

    private static List<string> Distinct(IEnumerable<string?> values) =>
        values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v!.Trim())
            .Distinct(StringComparer.CurrentCultureIgnoreCase)
            .Order(StringComparer.CurrentCultureIgnoreCase).ToList();

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task SaveAsync()
    {
        if (model is null) return;
        model.Name = model.Name.Trim();
        model.Description = Clean(model.Description);
        model.Value = Clean(model.Value);
        model.Package = Clean(model.Package);
        model.Manufacturer = Clean(model.Manufacturer);
        model.PartNumber = Clean(model.PartNumber);
        model.DatasheetUrl = Clean(model.DatasheetUrl);
        model.Notes = Clean(model.Notes);

        await using var db = await DbFactory.CreateDbContextAsync();
        if (IsNew) db.Parts.Add(model);
        else db.Parts.Update(model);
        await db.SaveChangesAsync();

        if (addAnother)
        {
            var message = $"\"{model.Name}\" gespeichert. Nächstes Bauteil:";
            if (IsNew)
            {
                // Bereits auf "Neu" → Formular direkt zurücksetzen, Kategorie & Lagerort behalten.
                model = new Part { CategoryId = model.CategoryId, StorageLocationId = model.StorageLocationId };
                savedMessage = message;
            }
            else
            {
                pendingMessage = message;
                Nav.NavigateTo($"parts/new?category={model.CategoryId}&location={model.StorageLocationId}");
            }
        }
        else
        {
            Nav.NavigateTo("parts");
        }
    }

    private void Duplicate()
    {
        if (model is null) return;
        var copy = new Part
        {
            Name = model.Name + " (Kopie)",
            Description = model.Description,
            Value = model.Value,
            Package = model.Package,
            Manufacturer = model.Manufacturer,
            PartNumber = model.PartNumber,
            MinQuantity = model.MinQuantity,
            DatasheetUrl = model.DatasheetUrl,
            Notes = model.Notes,
            CategoryId = model.CategoryId,
            StorageLocationId = model.StorageLocationId,
        };
        pendingCopy = copy;
        pendingMessage = "Kopie – Werte anpassen und speichern.";
        Nav.NavigateTo("parts/new");
    }

    private async Task DeleteAsync()
    {
        if (model is null || IsNew) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"\"{model.Name}\" wirklich löschen?")) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Parts.Where(p => p.Id == model.Id).ExecuteDeleteAsync();
        Nav.NavigateTo("parts");
    }
}
