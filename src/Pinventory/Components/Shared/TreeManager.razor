@typeparam TNode where TNode : class, ITreeNode, new()
@inject IDbContextFactory<PinventoryDbContext> DbFactory
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudPaper Outlined="true" Class="pa-3 mb-4">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="newName" Label="@($"Neue/r {Singular}")" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" OnKeyDown="OnNewKeyDown" @ref="newNameField" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudSelect T="int?" @bind-Value="newParentId" Label="unterhalb von" Placeholder="oberste Ebene" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true" Dense="true" ToStringFunc="PathOf">
                @foreach (var e in entries)
                {
                    <MudSelectItem T="int?" Value="e.Node.Id">
                        <span style="padding-left: @(e.Depth * 1.25)rem">@e.Node.Name</span>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@string.IsNullOrWhiteSpace(newName)" OnClick="AddAsync">
                Hinzufügen
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (entries.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine Einträge vorhanden.</MudAlert>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Outlined="true" Elevation="0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Beschreibung</th>
                <th style="text-align: right">Bauteile</th>
                <th style="width: 1%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in entries)
            {
                var node = e.Node;
                if (editId == node.Id)
                {
                    <tr>
                        <td colspan="3">
                            <div class="d-flex flex-wrap gap-2">
                                <MudTextField @bind-Value="editName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 12rem" AutoFocus="true" />
                                <MudTextField @bind-Value="editDescription" Label="Beschreibung" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 16rem" />
                                <MudSelect T="int?" @bind-Value="editParentId" Label="unterhalb von" Placeholder="oberste Ebene" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Clearable="true" Dense="true" ToStringFunc="PathOf" Style="min-width: 16rem">
                                    @foreach (var p in entries.Where(x => !editExcluded.Contains(x.Node.Id)))
                                    {
                                        <MudSelectItem T="int?" Value="p.Node.Id">
                                            <span style="padding-left: @(p.Depth * 1.25)rem">@p.Node.Name</span>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </td>
                        <td style="white-space: nowrap">
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" OnClick="SaveEditAsync" aria-label="Speichern" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => editId = null" aria-label="Abbrechen" />
                        </td>
                    </tr>
                }
                else
                {
                    var total = TotalCount(node.Id);
                    <tr>
                        <td style="padding-left: @(1 + e.Depth * 1.75)rem">
                            <div class="d-flex align-center gap-1">
                                @if (e.Depth > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Class="mud-text-secondary" />
                                }
                                <MudLink Href="@($"parts?{FilterQueryName}={node.Id}")" Typo="@(e.Depth == 0 ? Typo.subtitle2 : Typo.body2)">
                                    @node.Name
                                </MudLink>
                            </div>
                        </td>
                        <td><MudText Typo="Typo.body2" Class="mud-text-secondary">@node.Description</MudText></td>
                        <td style="text-align: right">
                            @if (total > 0)
                            {
                                <MudTooltip Text="@($"{directCounts.GetValueOrDefault(node.Id)} direkt, {total} inkl. Unterebenen")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@total</MudChip>
                                </MudTooltip>
                            }
                        </td>
                        <td style="white-space: nowrap">
                            <MudTooltip Text="Hier einlagern (Schnellerfassung)">
                                <MudIconButton Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Primary"
                                               Href="@($"parts/quick?{FilterQueryName}={node.Id}")" />
                            </MudTooltip>
                            <MudTooltip Text="Unterebene anlegen">
                                <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" OnClick="() => PrepareChildAsync(node.Id)" />
                            </MudTooltip>
                            <MudTooltip Text="Bearbeiten">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => StartEdit(node)" />
                            </MudTooltip>
                            <MudTooltip Text="Löschen">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(node)" />
                            </MudTooltip>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    /// <summary>z.B. "Kategorie" oder "Lagerort" – für Beschriftungen.</summary>
    [Parameter, EditorRequired] public string Singular { get; set; } = "";

    /// <summary>Query-Parameter für den Link in die Bauteilliste ("category" / "location").</summary>
    [Parameter, EditorRequired] public string FilterQueryName { get; set; } = "";

    /// <summary>Liefert die Anzahl Bauteile je Knoten-Id (nur direkt zugeordnete).</summary>
    [Parameter, EditorRequired] public Func<PinventoryDbContext, Task<Dictionary<int, int>>> LoadCounts { get; set; } = default!;

    private List<TNode> nodes = [];
    private List<TreeEntry<TNode>> entries = [];
    private Dictionary<int, string> paths = [];
    private Dictionary<int, int> directCounts = [];

    private MudTextField<string> newNameField = default!;
    private string newName = "";
    private int? newParentId;

    private int? editId;
    private string editName = "";
    private string? editDescription;
    private int? editParentId;
    private HashSet<int> editExcluded = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        nodes = await db.Set<TNode>().AsNoTracking().ToListAsync();
        directCounts = await LoadCounts(db);
        entries = Tree.Flatten(nodes);
        paths = entries.ToDictionary(e => e.Node.Id, e => e.Path);
    }

    private string PathOf(int? id) => id is int i ? paths.GetValueOrDefault(i) ?? "" : "";

    private int TotalCount(int id) =>
        Tree.SelfAndDescendants(nodes, id).Sum(i => directCounts.GetValueOrDefault(i));

    private async Task OnNewKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddAsync();
    }

    private async Task PrepareChildAsync(int parentId)
    {
        newParentId = parentId;
        newName = "";
        await newNameField.FocusAsync();
    }

    private async Task AddAsync()
    {
        var name = newName.Trim();
        if (name.Length == 0) return;
        if (nodes.Any(n => n.ParentId == newParentId && string.Equals(n.Name, name, StringComparison.CurrentCultureIgnoreCase)))
        {
            Snackbar.Add($"\"{name}\" gibt es auf dieser Ebene schon.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Set<TNode>().Add(new TNode { Name = name, ParentId = newParentId });
        await db.SaveChangesAsync();
        newName = "";
        await LoadAsync();
        Snackbar.Add($"\"{name}\" angelegt.", Severity.Success);
    }

    private void StartEdit(TNode node)
    {
        editId = node.Id;
        editName = node.Name;
        editDescription = node.Description;
        editParentId = node.ParentId;
        // Ein Knoten darf nicht unter sich selbst oder einen eigenen Unterknoten verschoben werden.
        editExcluded = Tree.SelfAndDescendants(nodes, node.Id);
    }

    private async Task SaveEditAsync()
    {
        var name = editName.Trim();
        if (name.Length == 0)
        {
            Snackbar.Add("Name darf nicht leer sein.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var node = await db.Set<TNode>().FindAsync(editId);
        if (node is not null)
        {
            node.Name = name;
            node.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
            node.ParentId = editParentId;
            await db.SaveChangesAsync();
        }
        editId = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(TNode node)
    {
        if (nodes.Any(n => n.ParentId == node.Id))
        {
            Snackbar.Add($"\"{node.Name}\" hat noch Unterebenen. Bitte diese zuerst löschen oder verschieben.", Severity.Warning);
            return;
        }

        var count = directCounts.GetValueOrDefault(node.Id);
        var message = count > 0
            ? $"\"{node.Name}\" löschen? {count} Bauteil(e) sind hier zugeordnet und verlieren die Zuordnung."
            : $"\"{node.Name}\" löschen?";
        var confirmed = await Dialogs.ShowMessageBoxAsync($"{Singular} löschen", message, yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Set<TNode>().FindAsync(node.Id);
        if (entity is not null)
        {
            db.Remove(entity);
            await db.SaveChangesAsync();
        }
        await LoadAsync();
        Snackbar.Add($"\"{node.Name}\" gelöscht.", Severity.Info);
    }
}
