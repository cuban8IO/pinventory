@inject NavigationManager Nav

<MudItem xs="6" md="3">
    <MudPaper Class="stat-card pa-4" Outlined="true" @onclick="() => Nav.NavigateTo(Href)">
        <div class="d-flex justify-space-between align-start">
            <div>
                <MudText Typo="Typo.h4" Color="Color" Class="stat-value">@Value</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Label</MudText>
            </div>
            <MudIcon Icon="@Icon" Color="@(Color == Color.Default ? Color.Primary : Color)" />
        </div>
    </MudPaper>
</MudItem>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public Color Color { get; set; } = Color.Default;
}
